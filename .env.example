# Copy this file to .env and fill in your values.
# .env is gitignored and should never be committed.

# College Football Data API key (free registration at collegefootballdata.com)
# Required for: fetch_rb_play_profiles.py, fetch_wr_route_profiles.py,
#               fetch_qb_play_profiles.py, compute_production_scores.py
CFBD_API_KEY=

# ── Loading this file ─────────────────────────────────────────────────────────
#
# macOS / Linux (bash/zsh):
#   export $(cat .env | xargs)
#
# Windows PowerShell:
#   $env:CFBD_API_KEY = "your_key_here"
#
# Or just set it inline before each script run:
#   macOS/Linux:  CFBD_API_KEY=your_key python3 scripts/fetch_rb_play_profiles.py
#   PowerShell:   $env:CFBD_API_KEY="your_key"; python3 scripts/fetch_rb_play_profiles.py
